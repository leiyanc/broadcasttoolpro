# Local development configuration. Copy this file to .env.local.
# Never commit real credentials.
BTP_ENV=development
BTP_APPLICATION_URL=http://127.0.0.1:8000/app
BTP_ALLOW_WEB_BOOTSTRAP=true
# Production and staging should use a mounted persistent location.
# BTP_DATA_DIR=/opt/render/project/src/data
# Technical working files only. Customer reports and backups are excluded.
BTP_TEMP_RETENTION_HOURS=24
# Keep disabled until the SES domain and production access are approved.
BTP_EMAIL_PROVIDER=disabled
BTP_EMAIL_FROM=Broadcast Tool Pro <notifications@broadcasttoolpro.com>
BTP_SES_REGION=us-east-1

# Use the restricted IAM user created only for SES delivery.
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Stripe Sandbox. Use test-mode keys and recurring Price IDs locally.
BTP_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
BTP_STRIPE_SECRET_KEY=sk_test_replace_me
BTP_STRIPE_WEBHOOK_SECRET=whsec_replace_me
BTP_STRIPE_PRICE_PROGRAMMING=price_replace_me
BTP_STRIPE_PRICE_PROFESSIONAL=price_replace_me
BTP_STRIPE_PRICE_ENTERPRISE=price_replace_me
BTP_STRIPE_PRICE_STREAM_MONITORING=price_replace_me
# Keep product access active for 72 hours after a failed recurring payment.
BTP_PAYMENT_GRACE_HOURS=72
