# Local development configuration. Copy this file to .env.local.
# Never commit real credentials.
BTP_ENV=development
BTP_APPLICATION_URL=http://127.0.0.1:8000/app
BTP_ALLOW_WEB_BOOTSTRAP=true
# Production and staging should use a mounted persistent location.
# BTP_DATA_DIR=/opt/render/project/src/data
# Keep disabled until the SES domain and production access are approved.
BTP_EMAIL_PROVIDER=disabled
BTP_EMAIL_FROM=Broadcast Tool Pro <notifications@broadcasttoolpro.com>
BTP_SES_REGION=us-east-1

# Use the restricted IAM user created only for SES delivery.
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
